      "name": "Auth",
      "item": [
        {
          "name": "1. Register (Đăng ký tài khoản)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", res.accessToken);",
                  "    pm.collectionVariables.set(\"refresh_token\", res.refreshToken);",
                  "}",
                  "if (res.user && res.user.email) {",
                  "    pm.collectionVariables.set(\"user_email\", res.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sinh Vien Lab2\",\n  \"email\": \"sinhvien_{{$timestamp}}@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login (Đăng nhập lấy Token)",
