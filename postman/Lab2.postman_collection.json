                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Order has totalAmount and orderCode\", function () {",
                  "    pm.expect(res.data).to.have.property('totalAmount');",
                  "    pm.expect(res.data).to.have.property('orderCode');",
                  "    pm.expect(res.data.totalAmount).to.eql(55980000);",
                  "    pm.collectionVariables.set(\"created_order_id\", res.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
